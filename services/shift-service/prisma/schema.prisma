generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Shift {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  shiftDate        DateTime  @map("shift_date") @db.Date
  startTime        DateTime  @map("start_time") @db.Timestamptz()
  endTime          DateTime  @map("end_time") @db.Timestamptz()
  shiftType        ShiftType @map("shift_type")
  sleepWindowStart DateTime? @map("sleep_window_start") @db.Timestamptz()
  sleepWindowEnd   DateTime? @map("sleep_window_end") @db.Timestamptz()
  workIntensity    Intensity @default(MODERATE) @map("work_intensity")
  commuteMinutes   Int       @default(0) @map("commute_minutes")
  isDayOff         Boolean   @default(false) @map("is_day_off")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([userId, shiftDate])
  @@index([userId, shiftDate(sort: Desc)])
  @@map("shifts")
}

model RotationPattern {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  patternName String   @default("Default") @map("pattern_name")
  cycleDays   Int      @map("cycle_days")
  pattern     Json // [{day: 1, type: 'night', start: '21:00', end: '05:00'}]
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("rotation_patterns")
}

// User-scheduled training sessions surfaced on the mobile Training Calendar's
// "Scheduled Sessions" list. shift-service is the natural home: it already owns
// time-anchored, per-user data. The backing table is created by the
// 20260617000000_scheduled_sessions migration, which is an UN-RUN file until a
// human deploys it — the /v1/training route degrades to 200 [] while the table
// is absent so dev keeps working pre-migration.
model ScheduledSession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz()
  notes       String?
  // OPTIONAL link to one of the user's own Shift rows so the calendar can later
  // contextualize training around a known shift. Scalar-only by design (no
  // Prisma relation / back-relation on Shift) to keep this strictly additive —
  // a single nullable column. Ownership (same userId) is enforced in the POST
  // handler, NOT by a DB FK constraint, so the un-run base table needs no
  // ordering against this column.
  shiftId     String?  @map("shift_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, scheduledAt])
  @@map("scheduled_sessions")
}

enum ShiftType {
  FIXED_NIGHT
  ROTATING
  SPLIT
  IRREGULAR
  TWELVE_HOUR
}

enum Intensity {
  SEDENTARY
  MODERATE
  DEMANDING
}
