{
    "name": "exercise-service",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "prisma generate && tsc && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
        "dev": "nodemon --watch src --exec \"node --max-old-space-size=4096 -r ts-node/register src/index.ts\"",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "db:seed": "npx -y tsx prisma/seed-library.ts",
        "db:seed:legacy": "ts-node --project tsconfig.json prisma/seed-library.ts",
        "lint": "eslint .",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@fastify/cors": "^8.5.0",
        "@fastify/helmet": "^11.1.1",
        "@fastify/jwt": "^8.0.0",
        "@fastify/rate-limit": "^9.1.0",
        "@nightfuel/config": "*",
        "@nightfuel/events": "*",
        "@nightfuel/types": "*",
        "@prisma/client": "^5.22.0",
        "fastify": "^4.26.1",
        "fastify-socket.io": "^5.1.0",
        "fastify-type-provider-zod": "^1.1.9",
        "socket.io": "^4.8.3",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "nodemon": "^3.1.0",
        "prisma": "^5.22.0",
        "ts-node": "^10.9.2",
        "typescript": "5.9.2"
    }
}
