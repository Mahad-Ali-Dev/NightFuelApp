generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("CHAT_DATABASE_URL")
  directUrl = env("CHAT_DIRECT_URL")
}

model CoachProfile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  specialty  String
  bio        String   @db.Text
  hourlyRate Float    @map("hourly_rate")
  rating     Float    @default(5.0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("coach_profiles")
}

model Conversation {
  id        String   @id @default(uuid())
  participantA String @map("participant_a")
  participantB String @map("participant_b")
  // Instagram-DM-style request gate. A new 1:1 conversation starts 'pending':
  // the requester (sender of the earliest message) may send exactly one message
  // until the recipient accepts. Migration backfills all pre-existing rows and
  // every Ria/coach conversation to 'accepted'. Values: 'pending'|'accepted'|'declined'.
  requestState String @default("pending") @map("request_state")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages  Message[]

  @@unique([participantA, participantB])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  text           String
  isRead         Boolean      @default(false) @map("is_read")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@map("messages")
}
