MEAL_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/nightfuel_meals?schema=public"
REDIS_URL="redis://localhost:6379"
MEAL_PORT=3006
JWT_SECRET="dev-secret"
PLAN_SERVICE_URL="http://localhost:3007"
# F34 #5 / GDPR purge: shared server-to-server token. Required (sent as
# X-Internal-Token) for the s2s call to plan-service AND to authorize this
# service's own /v1/meals/internal/* routes (e.g. the GDPR purge endpoint).
# Unset/empty => internal routes fail closed (404).
INTERNAL_SERVICE_TOKEN="dev-internal-token"
