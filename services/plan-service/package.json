{
    "name": "plan-service",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "prisma generate && tsc && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
        "dev": "nodemon --watch src --exec \"ts-node src/index.ts\"",
        "db:migrate": "prisma migrate dev",
        "db:studio": "prisma studio",
        "lint": "eslint .",
        "start": "node dist/index.js",
        "test": "jest --config jest.config.js"
    },
    "dependencies": {
        "@fastify/cors": "^8.5.0",
        "@fastify/helmet": "^11.1.1",
        "@fastify/jwt": "^8.0.0",
        "@fastify/rate-limit": "^9.1.0",
        "@nightfuel/config": "*",
        "@nightfuel/events": "*",
        "@nightfuel/types": "*",
        "@prisma/client": "^5.22.0",
        "@types/opossum": "^8.1.9",
        "fastify": "^4.26.1",
        "fastify-type-provider-zod": "^1.1.9",
        "opossum": "^9.0.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@babel/plugin-transform-modules-commonjs": "^7",
        "@babel/preset-typescript": "^7",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.0",
        "prisma": "^5.22.0",
        "ts-node": "^10.9.2",
        "typescript": "5.9.2"
    }
}
