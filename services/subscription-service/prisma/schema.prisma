// ─────────────────────────────────────────────────────────────────────────────
// NightFuel – subscription-service Prisma Schema
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUB_DATABASE_URL")
  directUrl = env("SUB_DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SubscriptionTier {
  FREE
  PRO
  PREMIUM
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Subscription {
  id                 String           @id @default(uuid())
  userId             String           @unique @map("user_id")
  tier               SubscriptionTier @default(FREE)
  status             SubStatus        @default(ACTIVE)
  currentPeriodStart DateTime         @map("current_period_start")
  currentPeriodEnd   DateTime?        @map("current_period_end")
  cancelAtPeriodEnd  Boolean          @default(false) @map("cancel_at_period_end")
  stripeCustomerId   String?          @map("stripe_customer_id")
  stripeSubId        String?          @map("stripe_sub_id")
  stripeConnectId    String?          @map("stripe_connect_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model SubscriptionEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  eventType String   @map("event_type")
  fromTier  String?  @map("from_tier")
  toTier    String?  @map("to_tier")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("subscription_events")
}

// ─── IAP receipt binding (CRITICAL #1 — receipt replay / sharing) ──────────────
// One row per validated Apple/Google subscription receipt, keyed by the
// platform's STABLE cross-renewal identifier (Apple originalTransactionId /
// Google orderId-or-purchaseToken). The @@unique on originalTransactionId is the
// hard guarantee that a single valid receipt can upgrade exactly ONE account:
// the validate route binds the receipt to the first userId that redeems it, and
// any later submission of the SAME receipt by a DIFFERENT user is rejected (the
// row already belongs to someone else). A re-submit by the SAME user is an
// idempotent re-affirm. See SubscriptionService.bindIapTransaction.
model IAPTransaction {
  id                    String   @id @default(uuid())
  originalTransactionId String   @unique @map("original_transaction_id")
  userId                String   @map("user_id")
  platform              String
  productId             String   @map("product_id")
  tier                  String
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("iap_transactions")
}
