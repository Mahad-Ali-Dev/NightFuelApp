{
    "name": "@nightfuel/events",
    "version": "0.0.0",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "jest",
        "lint": "eslint ."
    },
    "dependencies": {
        "@nightfuel/types": "*",
        "ioredis": "^5.3.2",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@babel/plugin-transform-modules-commonjs": "^7",
        "@babel/preset-typescript": "^7",
        "@types/jest": "^29.5.14",
        "jest": "^29.7.0",
        "typescript": "5.9.2"
    },
    "jest": {
        "rootDir": ".",
        "roots": [
            "<rootDir>/__tests__"
        ],
        "testMatch": [
            "**/*.test.ts"
        ],
        "transform": {
            "^.+\\.ts$": [
                "babel-jest",
                {
                    "presets": [
                        "@babel/preset-typescript"
                    ],
                    "plugins": [
                        "@babel/plugin-transform-modules-commonjs"
                    ]
                }
            ]
        },
        "testEnvironment": "node"
    }
}