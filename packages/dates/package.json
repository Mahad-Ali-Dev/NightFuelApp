{
    "name": "@nightfuel/dates",
    "version": "0.0.1",
    "private": true,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "test": "jest",
        "check-types": "tsc --noEmit",
        "lint": "eslint ."
    },
    "devDependencies": {
        "@babel/plugin-transform-modules-commonjs": "^7",
        "@babel/preset-typescript": "^7",
        "@repo/typescript-config": "*",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "jest": "^29.7.0",
        "typescript": "5.9.2"
    },
    "jest": {
        "rootDir": ".",
        "roots": [
            "<rootDir>/__tests__"
        ],
        "testMatch": [
            "**/*.test.ts"
        ],
        "transform": {
            "^.+\\.ts$": [
                "babel-jest",
                {
                    "presets": [
                        "@babel/preset-typescript"
                    ],
                    "plugins": [
                        "@babel/plugin-transform-modules-commonjs"
                    ]
                }
            ]
        },
        "testEnvironment": "node"
    }
}
