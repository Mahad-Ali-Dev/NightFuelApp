# Backend API base URL (Nginx gateway — NOT individual microservice ports)
# For Android emulator: http://10.0.2.2
# For iOS simulator:    http://localhost
# For physical device:  http://<your-local-ip>
# For production:       https://api.nightfuel.app
API_BASE_URL=http://10.0.2.2
EXPO_PUBLIC_NF_API_BASE_URL=http://10.0.2.2:3000/api

# Sentry crash + error reporting (set this for staging + prod via EAS env vars,
# leave empty in dev — the SDK is initialized in disabled state without a DSN).
# Get a DSN at: https://sentry.io/settings/<org>/projects/<project>/keys/
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_BARCODE_SCANNER=true
ENABLE_HEALTH_SYNC=true
