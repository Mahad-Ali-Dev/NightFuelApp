# Backend API base URL (Nginx gateway — NOT individual microservice ports)
# For Android emulator: http://10.0.2.2
# For iOS simulator:    http://localhost
# For physical device:  http://<your-local-ip>
# For production:       https://api.nightfuel.app
API_BASE_URL=http://10.0.2.2

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_BARCODE_SCANNER=true
ENABLE_HEALTH_SYNC=true
