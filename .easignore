# .easignore — controls what is uploaded to EAS Build.
# When present, EAS uses THIS file instead of .gitignore, so the entries below
# mirror .gitignore. The one meaningful addition is `package-lock.json` at the
# bottom: excluding it makes EAS run the lenient `npm install` instead of the
# strict `npm ci`, which avoids an npm-version-sensitive lockfile sync error in
# this workspace (npm ci on the build server reported `Missing: react@19.2.7`).

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo
turbo*.log

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
*.tsbuildinfo

# Prisma generated client + native binaries
**/src/generated/
*.dll.node
*.tmp[0-9]*

# Mobile build artifacts (Expo)
.expo/
.expo-shared/
expo_log.txt
ios/Pods
ios/build
android/build
android/.gradle
android/app/build
*.apk
*.aab
*.ipa

# Large native installers
*.msi
*.exe
*.dmg
*.pkg

# Build / install noise
npm-debug.log*
yarn-debug.log*
yarn-error.log*
npm_install.log
tsc.log
tsc_output*.txt
val_err.txt

# Misc
.DS_Store
*.pem
.mcp.json
.claude/settings.local.json

# Python
.venv
venv/
__pycache__/
*.pyc

# demo-url content-check cache
scripts/.cache/demo-urls/

# === EAS-specific ===
# Exclude the lockfile so EAS runs `npm install` (reconciles the tree) instead
# of `npm ci` (strict sync check). The lockfile remains committed in the repo.
package-lock.json
