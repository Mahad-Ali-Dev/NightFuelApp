# ═══════════════════════════════════════════════════════════════════════════════
# NightFuel — VPS / production env for docker-compose
# Copy to `.env` in THIS directory (infra/docker/) and fill in.
#   cp .env.production.example .env
# docker-compose substitutes these ${VARS}. Postgres + Redis URLs are NOT here —
# the compose file wires them to the internal `postgres`/`redis` containers.
# NEVER commit the filled-in .env.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Shared JWT signing secret for all services. Generate a fresh one:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# ─── AI (optional) ───────────────────────────────────────────────────────────
# Real Claude-powered plans/coach. Without a real key the ai-pipeline returns
# canned demo text (a "mock-key" short-circuit) and the rest of the app works.
ANTHROPIC_API_KEY=mock-key
OPENAI_API_KEY=mock-key

# ─── Stripe (optional — only needed for web subscription checkout) ───────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ─── Web Push / VAPID (optional — only for browser push) ─────────────────────
# Generate real ones with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=VAPID_PLACEHOLDER_PUBLIC
VAPID_PRIVATE_KEY=VAPID_PLACEHOLDER_PRIVATE
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ─── Expo push (optional — improves mobile push delivery) ────────────────────
EXPO_ACCESS_TOKEN=
