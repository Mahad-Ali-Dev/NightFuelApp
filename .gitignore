# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo
turbo*.log

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
*.tsbuildinfo

# Prisma generated client + native binaries — regenerated by `prisma generate`.
# These are platform-specific (e.g. query_engine-windows.dll.node) and must not be committed.
**/src/generated/
*.dll.node
# Prisma writes temp files during regeneration on Windows; never commit these
*.tmp[0-9]*

# Mobile build artifacts (Expo)
.expo/
.expo-shared/
expo_log.txt
ios/Pods
ios/build
android/build
android/.gradle
android/app/build
*.apk
*.aab
*.ipa

# Large native installers — should not live in the repo (too big, OS-specific)
*.msi
*.exe
*.dmg
*.pkg

# Build / install noise
npm-debug.log*
yarn-debug.log*
yarn-error.log*
npm_install.log
tsc.log
tsc_output*.txt
val_err.txt

# Misc
.DS_Store
*.pem
.mcp.json

# Claude Code local settings (personal — may contain API keys / paths)
.claude/settings.local.json

# Python
.venv
venv/
__pycache__/
*.pyc
