{
  "name": "nightfuel",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "setup": "bash scripts/setup-dev.sh",
    "security:scan": "gitleaks detect --config .gitleaks.toml --redact"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.8.10",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "clients/*",
    "services/*",
    "packages/*"
  ],
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv": "^17.3.1",
    "expo": "~54.0.0",
    "react-native-mmkv": "^2.12.2",
    "react-native-worklets": "^0.7.4"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  }
}